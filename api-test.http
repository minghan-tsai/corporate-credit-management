### 23. AuditLog 最終驗證 SQL（目前沒有 AuditLog 查詢 API）
# SELECT id, actor_username, action, entity_type, entity_id, created_at
# FROM audit_logs
# WHERE (entity_type = 'CREDIT_APPLICATION'
#        AND entity_id IN (
#            <stage9 approve application id>,
#            <stage9 reject application id>))
#    OR (entity_type = 'DRAWDOWN'
#        AND entity_id = <stage9 drawdown id>)
# ORDER BY id;
#
# 預期成功紀錄：
# stage5_rm       / CREATE_CREDIT_APPLICATION
# stage5_rm       / SUBMIT_CREDIT_APPLICATION
# stage5_reviewer / APPROVE_CREDIT_APPLICATION
# stage5_rm       / CREATE_CREDIT_APPLICATION
# stage5_rm       / SUBMIT_CREDIT_APPLICATION
# stage5_reviewer / REJECT_CREDIT_APPLICATION
# stage5_rm       / CREATE_DRAWDOWN
#
# 重複 Submit、Excess Drawdown 與其他失敗 action 不得產生成功 AuditLog。
